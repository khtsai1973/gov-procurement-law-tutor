generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  USER
}

enum RegulationTier {
  LAW
  REGULATION
  ADMIN_RULE
  INTERPRETATION
  QUESTION_BANK
}

/// 使用者對 AI 回答的滿意度（供模型回答品質評估）
enum AnswerFeedback {
  UP
  DOWN
}

/// 訪客註冊申請審核狀態
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  /// 模擬考試顯示用暱稱（可自訂，與 Google 姓名無關）
  nickname      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  questions     UserQuestion[]
  examSupplements MockExamSupplement[]
  mockExamSessions MockExamSession[]
  unitMaterials UnitMaterial[]
}

/// 訪客註冊申請（可申請老師或一般使用者；由管理者審核後始可 Google 登入加入）
model RegistrationApplication {
  id            String             @id @default(cuid())
  /// 正規化小寫信箱
  email         String             @unique
  name          String?
  /// 僅允許 USER 或 TEACHER（應用層驗證）
  requestedRole Role
  note          String?
  status        RegistrationStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, createdAt])
}

/// 老師製作的單元教材（學員可閱讀已發布者）
model UnitMaterial {
  id        String   @id @default(cuid())
  title     String
  /// 主題分類（正式 14 類之一）
  category  String   @default("政府採購全生命週期概論")
  /// 單元代號，如 U01、第1單元
  unitCode  String?
  summary   String?
  content   String
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([published, category, sortOrder])
  @@index([category])
  @@index([authorId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Regulation {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  tier           RegulationTier
  /// 同位階內排序：數字越小越前面（常用於施行日/文號）
  sortOrder      Int            @default(0)
  lastModifiedAt DateTime?
  sourceUrl      String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  chunks         DocChunk[]
}

model DocChunk {
  id           String     @id @default(cuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  content      String
  chunkIndex   Int
  /// OpenAI embedding JSON 陣列；有值時啟用語意檢索（較接近 NotebookLM）
  /// Parent-Child：僅 CHILD（小切片）寫入 embedding；PARENT 供命中後餵給模型
  embedding    String?
  /// PARENT＝粗切片（完整條文上下文）；CHILD＝小切片（向量／關鍵字搜尋）
  chunkRole    String     @default("CHILD")
  /// CHILD 指向所屬 PARENT；舊資料可為 null（扁平切片，搜尋與上下文皆用自身）
  parentId     String?
  parent       DocChunk?  @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocChunk[] @relation("ParentChildren")
  /// 條號鍵，如「第 48 條」，便於 Contextual 擴展（對應施行細則）
  articleKey   String?
  createdAt    DateTime   @default(now())

  @@index([regulationId])
  @@index([chunkRole])
  @@index([parentId])
  @@index([articleKey])
}

model UserQuestion {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      String
  answer        String?
  sources       String?
  /// 產生回答時使用的模型／模式（如 gpt-4o-mini、off-topic、keyword-fallback）
  answerModel   String?
  /// RAG 檢索模式（如 rag-semantic、off-topic）
  retrievalMode String?
  /// 👍 / 👎 滿意度
  feedback      AnswerFeedback?
  /// 簡易文字回饋（選填）
  feedbackComment String?
  feedbackAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([feedback])
  @@index([createdAt])
}

model KnowledgeSync {
  id          String   @id @default(cuid())
  triggeredBy String
  status      String
  message     String?
  createdAt   DateTime @default(now())
}

/// 題庫：常見提問與關鍵詞，供 RAG 查詢擴展與法規 slug 加權（非條文原文）
model QuestionBankItem {
  id           String   @id @default(cuid())
  /// 匯入用穩定鍵（對應 JSON `key`）
  key          String   @unique
  question     String
  keywords     String[]
  relatedSlugs String[]
  hintAnswer   String?
  category     String
  /// 知識標籤（受控詞彙；可空，執行時以規則自 category／keywords 推導）
  knowledgeTags String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

/// 使用者對題庫題目補充的解答／筆記（當題庫無 hint 時）
model MockExamSupplement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey    String
  supplement String
  /// 使用者註記的解答來源（法條、函釋等）
  sourceNote String?
  /// 學員請老師指導時的簡短提問（選填）
  guidanceAskNote String?
  /// 學員送出「請老師指導」的時間
  guidanceRequestedAt DateTime?
  /// 老師回覆的指導內容
  teacherGuidance String?
  /// 老師回覆時間
  guidanceRepliedAt DateTime?
  /// 回覆的老師使用者 id
  guidanceByUserId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, itemKey])
  @@index([userId])
  @@index([guidanceRequestedAt])
}

/// 模擬考試場次（含計時與成績）
model MockExamSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String?
  questionType   String
  requestedCount Int
  actualCount    Int
  timedMode      Boolean  @default(false)
  timeLimitSec   Int?
  elapsedSec     Int?
  answeredCount  Int      @default(0)
  correctCount   Int      @default(0)
  gradableCount  Int      @default(0)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  /// 交卷後：LLM 語意化診斷全文（由弱點標籤驅動）
  diagnosticSummary String?
  /// JSON：建議補強法規 [{ slug, title, sourceUrl, reason? }]
  diagnosticRecommendations String?
  diagnosticModel   String?
  diagnosedAt       DateTime?
  /// JSON：確定性雷達快照 KnowledgeRadarSnapshot
  diagnosticRadar   String?
  answers        MockExamSessionAnswer[]

  @@index([userId, startedAt])
}

model MockExamSessionAnswer {
  id              String          @id @default(cuid())
  sessionId       String
  session         MockExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemKey         String
  questionIndex   Int
  userAnswer      String?
  referenceAnswer String?
  isCorrect       Boolean?
  revealed        Boolean         @default(false)
  /// 該場測驗中使用者註記的解答來源
  sourceNote      String?
  /// LLM 逐題診斷要點（可空）
  diagnosticNote  String?

  @@index([sessionId])
}
