        "government-procurement-act"
      ],
      "expected_articles": [
        "第50條"
      ],
      "expected_behavior": "answer",
      "notes": "列舉主要款次即可，勿捏造未出現款次。",
      "phase": 1,
      "status": "ready",
      "must_include": [
        "第50條",
        "不予開標",
        "不決標"
      ]
