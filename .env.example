# PostgreSQL（本機或 Neon；勿提交真實連線字串到 Git）
# 舊版 SQLite（file:./dev.db）已不再支援 — 若仍見 P1012，請改為 postgresql://
# 本機 Docker：docker compose up -d  →  DATABASE_URL 見下方
# Neon：https://neon.tech 建立專案後複製 Connection string（建議加 ?sslmode=require）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gov_procurement"
# Neon／Vercel：建議使用 pooled connection string；程式會自動補 connect_timeout、connection_limit（若尚未設定）
# 例：postgresql://…@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="請改成隨機長字串"
# Google OAuth（專案 government-procurement-act2）詳見 GOOGLE-OAUTH.md、DEPLOY.md
# 本機重新導向 URI: http://localhost:3000/api/auth/callback/google
# 正式環境另加: https://你的網域.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
# Auth.js 也支援下列別名（二擇一即可）
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# 逗號分隔信箱清單；列名者登入後為 ADMIN（優先於老師）
ADMIN_EMAILS="khtsai1973@gmail.com"
# 逗號分隔信箱清單；列名者登入後為 TEACHER（可製作單元教材、檢視學員成績）
# 注意：sports20140906@gmail.com 已內建為老師；此處可再追加其他人
TEACHER_EMAILS="sports20140906@gmail.com"
# 選填：有設定時回答改由模型在摘錄範圍內生成
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# 設為 true 時永遠不用 OpenAI，僅回傳知識庫摘錄（額度用完時可設）
OPENAI_DISABLED="false"
# RAG 檢索（需 corpus:ingest；Parent-Child 見 docs/RAG-PARENT-CHILD.md）
RAG_FETCH_K="40"
RAG_TOP_K="8"
RAG_MMR_LAMBDA="0.65"

# --- 資安／RLS ---
# 題庫強制重匯 API 的 Bearer 密鑰（POST /api/admin/reimport-question-bank）
QUESTION_BANK_REIMPORT_SECRET=""
# 設為 true 時對使用者資料表 FORCE ROW LEVEL SECURITY（須全程使用 withUserRls／withRlsBypass）
ENABLE_FORCE_RLS="false"

# --- 部署備註（Vercel + Neon）---
# 1. 在 Neon 建立資料庫，將 DATABASE_URL 設到 Vercel → Settings → Environment Variables（建議用 pooled／-pooler 連線）
# 2. Vercel 上 NEXTAUTH_URL / AUTH_URL 設為 https://你的網域.vercel.app
# 3. 首次部署後在本機對「正式 DATABASE_URL」執行：npm run db:push && npm run db:seed && npm run corpus:rag-init
# 4. 效能：可用排程定期 GET /api/health 預熱 serverless；教材列表僅載摘要（60s 快取），全文點選後載入
# 詳細步驟見 DEPLOY.md
